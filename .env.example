# ───────── Server ─────────
PORT=4200

# ───────── MongoDB (Atlas) ─────────
# MongoDB Atlas cloud connection string
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/relations

# ───────── JWT ─────────
JWT_SECRET=your_super_secret_key

# ───────── CORS ─────────
# Frontend domeni (Netlify URL). Bir nechta bo'lsa vergul bilan: https://a.com,https://b.com
CORS_ORIGIN=http://localhost:5173

# ───────── Telegram Bot ─────────
# @BotFather dan olingan token
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyz

# Admin telegram ID(lar)i — vergul bilan ajratilgan. @userinfobot dan ID oling.
ADMIN_TELEGRAM_IDS=123456789

# Production webhook domeni (masalan https://your-app.onrender.com).
# Bo'sh qoldirilsa bot POLLING rejimida ishlaydi (local development uchun).
WEBHOOK_DOMAIN=
